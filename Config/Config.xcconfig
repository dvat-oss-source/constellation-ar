GEMMA_MODEL_ID = gemma-4-26b-a4b-it-maas
NARRATION_MODEL_ID = gemini-3-flash-preview

// Optional local override in Secrets.xcconfig for an existing installation.
APP_BUNDLE_IDENTIFIER = org.constellationar.app

// Gemma MaaS is only served from the global location, which needs the project-scoped URL.
// Set your cloud project in the git-ignored Secrets.xcconfig.
GCP_PROJECT_ID =
GEMMA_LOCATION = global

// Set your Apple development team in the git-ignored Secrets.xcconfig.
DEVELOPMENT_TEAM =

// Last so a local Secrets.xcconfig can also override DEVELOPMENT_TEAM.
#include? "Secrets.xcconfig"
